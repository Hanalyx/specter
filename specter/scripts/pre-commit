#!/bin/sh
# pre-commit hook: documentation style on staged docs and comments, then formatting
# and vet on staged Go files.
# Install with: make install-hooks

set -e

# Resolve the repository root from git, not from $0.
#
# This hook is installed at .git/hooks/pre-commit, so `dirname $0` is `.git/hooks`.
# The earlier version derived the module root as `$0/../specter`, which resolves to
# `.git/specter`. That directory does not exist, so the hook took its "cannot find the
# module" branch and exited 0 on every commit. gofmt and go vet never ran.
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

MODULE_ROOT="$REPO_ROOT/specter"
CHECKER="specter/scripts/check-doc-style.py"

# --- Documentation style -----------------------------------------------------------
# Runs from the repository root on purpose. The checker resolves paths against its own
# working directory, so from specter/ every path misses and it reports the files clean
# instead of failing. See bugs/SP-HP-026.
#
# Named files, not --changed: --changed diffs the branch against main, which is the
# wrong question for a commit that has not been made yet.
STAGED_STYLE=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '\.(md|go|ts|tsx|mts|cts|py|js|jsx|mjs|cjs|yml|yaml|json)$' || true)

if [ -n "$STAGED_STYLE" ] && [ -f "$CHECKER" ] && command -v python3 >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  if ! python3 "$CHECKER" $STAGED_STYLE; then
    echo ""
    echo "specter pre-commit: documentation style check failed."
    echo "Grade 10, US English, no em dashes, no emojis, no AI speak."
    echo "See dev/DEVELOPER_DOCUMENTATION_STYLE_GUIDE in the Context Plane."
    echo "Fix the prose, or add a 'doc-style: allow' escape to a line a maintainer cleared."
    exit 1
  fi
fi

# --- Go formatting and vet ---------------------------------------------------------
STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO" ]; then
  exit 0
fi

if [ ! -d "$MODULE_ROOT" ]; then
  echo "specter pre-commit: cannot find the Go module at $MODULE_ROOT" >&2
  exit 1
fi

# Strip the "specter/" prefix so paths are relative to the module root.
MODULE_RELATIVE=$(echo "$STAGED_GO" | sed 's|^specter/||' | grep '\.go$' || true)

if [ -z "$MODULE_RELATIVE" ]; then
  exit 0
fi

# gofmt check. Run from the module root so paths resolve correctly.
UNFORMATTED=$(cd "$MODULE_ROOT" && echo "$MODULE_RELATIVE" | xargs gofmt -l 2>/dev/null)
if [ -n "$UNFORMATTED" ]; then
  echo "specter pre-commit: these files need gofmt:"
  echo "$UNFORMATTED"
  echo "Run: make fmt"
  exit 1
fi

# go vet on changed packages (derive import paths from relative dirs).
PKGS=$(echo "$MODULE_RELATIVE" | xargs -I{} dirname {} | sort -u | sed 's|^|github.com/Hanalyx/specter/|')
(cd "$MODULE_ROOT" && go vet $PKGS 2>&1) || exit 1

exit 0
